class Harnfig < Formula
  desc "Declaratively install Agent Skills from GitHub"
  homepage "https://github.com/pfedotovsky/harnfig"
  version "@@VERSION@@"
  license "Apache-2.0"

  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/pfedotovsky/harnfig/releases/download/v@@VERSION@@/harnfig-v@@VERSION@@-osx-arm64.tar.gz"
      sha256 "@@OSX_ARM64_SHA@@"
    else
      url "https://github.com/pfedotovsky/harnfig/releases/download/v@@VERSION@@/harnfig-v@@VERSION@@-osx-x64.tar.gz"
      sha256 "@@OSX_X64_SHA@@"
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      url "https://github.com/pfedotovsky/harnfig/releases/download/v@@VERSION@@/harnfig-v@@VERSION@@-linux-arm64.tar.gz"
      sha256 "@@LINUX_ARM64_SHA@@"
    else
      url "https://github.com/pfedotovsky/harnfig/releases/download/v@@VERSION@@/harnfig-v@@VERSION@@-linux-x64.tar.gz"
      sha256 "@@LINUX_X64_SHA@@"
    end
  end

  def install
    bin.install "harnfig"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/harnfig version")
  end
end
